# Smart AI Gateway Production Environment Variables
# Copy to .env or set in your production secret manager

# Application Configuration
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & Master API Key
GATEWAY_API_KEY=your-secure-gateway-master-key-here
ALLOWED_CORS_ORIGINS=["*"]
MAX_REQUEST_BODY_BYTES=1048576

# Persistence
DATABASE_URL=sqlite:///./data/gateway_traces.db

# Caching & Reliability
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30.0
MAX_PROVIDER_ATTEMPTS=3

# Default Model Aliases (Override with user BYOK in playground)
CHEAP_MODEL_ALIAS=llama-3.1-8b-instant
STRONG_MODEL_ALIAS=gpt-4o
FALLBACK_MODEL_ALIAS=gpt-4o
