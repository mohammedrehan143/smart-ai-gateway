# ==============================================================================
# SMART AI GATEWAY - CONFIGURATION & CREDENTIALS
# ==============================================================================

# Application Environment (local / test / production)
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Gateway Authentication
# Leave empty for local development bypass.
# In production, set a strong bearer token (e.g., gw_live_xxxxxxxxxxxx).
GATEWAY_API_KEY=

# Persistence (SQLite for local, PostgreSQL for multi-worker production)
DATABASE_URL=sqlite:///./gateway_traces.db

# Caching (In-memory for single process, Redis for distributed cluster)
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
REDIS_URL=

# ==============================================================================
# AI MODEL ALIASES & CREDENTIALS
# ==============================================================================

# --- OPTION A: Single Provider (e.g. OpenAI) ---
# If you use OpenAI for both cheap and strong models, configure here:
PROVIDER_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
PROVIDER_BASE_URL=https://api.openai.com/v1

CHEAP_MODEL_ALIAS=gpt-4o-mini
STRONG_MODEL_ALIAS=gpt-4o
FALLBACK_MODEL_ALIAS=gpt-4o

# --- OPTION B: Separate Providers for Cheap vs Strong (Optional overrides) ---
# Example: Use Groq / DeepSeek for Cheap, and OpenAI for Strong:
# CHEAP_PROVIDER_API_KEY=gsk_YOUR_GROQ_KEY
# CHEAP_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# CHEAP_MODEL_ALIAS=llama-3.1-8b-instant

# STRONG_PROVIDER_API_KEY=sk-proj-YOUR_OPENAI_KEY
# STRONG_PROVIDER_BASE_URL=https://api.openai.com/v1
# STRONG_MODEL_ALIAS=gpt-4o

# ==============================================================================
# RESILIENCY & LIMITS
# ==============================================================================
REQUEST_TIMEOUT_SECONDS=30.0
MAX_PROVIDER_ATTEMPTS=3
MAX_INPUT_TOKENS=8192
MAX_OUTPUT_TOKENS=4096
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_RPM=120

# Versioning
ROUTING_POLICY_VERSION=1.0.0
RATE_CARD_VERSION=2026-11-01
STORE_PROMPT_CONTENT=false
